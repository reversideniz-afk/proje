{
  "name": "desktop",
  "private": true,
  "version": "2.2.0",
  "description": "Arkadaş grubu için sesli/görüntülü sohbet uygulaması",
  "author": "Alganis",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:vite:dev\" \"npm:electron:dev\"",
    "vite:dev": "vite",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.alganis.seslisohbet",
    "productName": "Disco",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "reversideniz-afk",
      "repo": "proje",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Disco",
        "schemes": [
          "disco"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "1.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  }
}
