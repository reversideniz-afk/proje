# Bağımlılıklar — npm install ile her zaman yeniden oluşturulabilir,
# Git'e hiç gerek yok (binlerce dosya, yüzlerce MB olabilir).
node_modules/

# GİZLİ bilgiler (veritabanı bağlantı adresi vb.) — ASLA GitHub'a
# gitmemeli. Bu dosyalar sadece kendi bilgisayarında kalmalı.
.env
.env.local

# Derleme çıktısı — npm run build / npm run package ile her zaman
# yeniden üretilebilir. "release" özellikle önemli — paketlenmiş
# .exe (yüzlerce MB) buraya gidiyor, Git'e KESİNLİKLE girmemeli.
dist/
release/

# İşletim sistemi / editör dosyaları
.DS_Store
Thumbs.db
